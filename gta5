server {
    listen 80;
    server_name gta5.blykio.com; # RÄTTAT: Ta bort ://
    
    # Redirect all HTTP traffic to HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name gta5.blykio.com; # RÄTTAT: Ta bort ://

    # SSL Certificates - RÄTTAT: Tog bort :// och lade till gta5. om certifikatet ligger där
    ssl_certificate /etc/letsencrypt/live/gta5.blykio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gta5.blykio.com/privkey.pem;

    # Web Root Directory
    root /gta5/mirror/playgta5.com;
    index index.html;

    # Cross-Origin Isolation headers required for WebAssembly / SharedArrayBuffer
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    # Block malicious .env scanner bots
    location ~ /\.env {
        deny all;
        return 404;
    }

    # Serve static web assets directly via Nginx; fallback to Python
    location / {
        try_files $uri $uri/ @python_backend;
    }

    # Proxy fallback for dynamic/API routes to Python backend
    location @python_backend {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
