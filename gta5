server {
    listen 80;
    server_name gta5.blykio.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name gta5.blykio.com;

    # SSL-certifikat - RÄTTAT: Tog bort :// och lade till gta5.
    ssl_certificate /etc/letsencrypt/live/gta5.blykio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gta5.blykio.com/privkey.pem;

    root /root/Downloads/playgta5-offline/mirror;
    index index.html;

    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;

    client_max_body_size 1000M;
    proxy_read_timeout 600s;

    # Hantera spelfiler och WebAssembly blixtsnabbt direkt i Nginx
    location ~* \.(wasm|data|symbols|unityweb)$ {
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "require-corp" always;
        add_header Access-Control-Allow-Origin "*" always;
        default_type application/octet-stream;
        try_files $uri =404;
    }

    location ~ /\.env {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ @python_backend;
    }

    location @python_backend {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
